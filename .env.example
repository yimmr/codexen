# ==============================================================================
# Codexen 环境变量模板 (复制为 .env 使用)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Cloudflare 命名隧道 Token (生产主力推荐 / 最佳实践)
# ------------------------------------------------------------------------------
# 在 Cloudflare Zero Trust -> Networks -> Tunnels 中查看/获取命名隧道 (Named Tunnel) Token。
# 本地 cloudflared 启动时使用此 Token 建立安全加密通道，免暴露公网 IP 与路由器打洞。
# 若留空，launcher.py 会自动回退为纯本地回环模式 (127.0.0.1:8788)。
CLOUDFLARE_TUNNEL_TOKEN=

# ------------------------------------------------------------------------------
# 2. 安全访问密钥 (强制/推荐)
# ------------------------------------------------------------------------------
# 本地回源 Bearer Token 校验密钥。
# 当 Cloudflare MCP Server 回源调用本地隧道时，必须在请求头中携带:
#   Authorization: Bearer <MCP_API_KEY>
# 若留空，初次启动时系统将自动生成高强度随机密钥 (sec_*) 并自动写回 .env
MCP_API_KEY=
MCP_REQUIRE_AUTH=true

# ------------------------------------------------------------------------------
# 3. 网络与服务端点配置 (两层域名分工体系)
# ------------------------------------------------------------------------------
MCP_HOST=127.0.0.1
MCP_PORT=8788

# 【第一层：对外门户端点】面向 ChatGPT / Claude / 外部 Agent 的统一访问域名
# 对应 Cloudflare Zero Trust -> Access -> AI Controls -> MCP Portals 绑定的公网域名
# 例如: https://mcp.yourdomain.com (对外 MCP 接入地址为 https://mcp.yourdomain.com/mcp)
MCP_PORTAL_URL=https://mcp.yourdomain.com

# 【第二层：内部隧道端点】Cloudflare Ingress 映射到本机 127.0.0.1:8788 的回源公网域名
# 对应 Cloudflare Zero Trust -> Networks -> Tunnels 中 Public Hostname 绑定的域名
# 例如: https://codexen.yourdomain.com/mcp
MCP_UPSTREAM_URL=https://codexen.yourdomain.com/mcp

# ------------------------------------------------------------------------------
# 4. 自主 OAuth 2.1 认证开关 (⚠️ 实验性 / 备用方案 / 安全性未核实)
# ------------------------------------------------------------------------------
# 默认值: false (关闭)。生产环境强烈建议通过 Cloudflare MCP 门户进行统一边缘安全鉴权。
# 仅当无需 CF 门户且欲在本地纯回环测试 ChatGPT OAuth 协议时才设为 true。
MCP_ENABLE_PUBLIC_OAUTH=false
MCP_ALLOW_QUERY_AUTH=false
